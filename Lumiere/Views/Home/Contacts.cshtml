@{
    ViewData["Title"] = "Контакты";
    var menu = (Lumiere.Models.MenuData)ViewBag.Menu!;
}

<section>
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">Как нас найти</span>
            <h1 class="h2">Контакты</h1>
            <div class="rule"></div>
        </div>

        <div class="contact-grid">
            <div class="contact-item">
                <span class="eyebrow">Адрес</span>
                <h3>@menu.Address</h3>
                <p>@menu.City<br />Ориентир — витрина пирожковых на углу</p>
            </div>
            <div class="contact-item">
                <span class="eyebrow">Телефон</span>
                <h3><a href="tel:@menu.Phone">@menu.Phone</a></h3>
                <p>Звонки и сообщения принимаем<br />ежедневно до закрытия</p>
            </div>
            <div class="contact-item">
                <span class="eyebrow">Часы работы</span>
                <h3>@menu.WorkStart — @menu.WorkEnd</h3>
                <p>Без выходных. Кухня работает<br />до закрытия зала</p>
            </div>
            <div class="contact-item">
                <span class="eyebrow">Доставка</span>
                <h3>@((menu.DeliveryPrice / 100).ToString("0")) ₽</h3>
                <p>По городу, среднее время<br />доставки — 45 минут</p>
            </div>
        </div>

        <div class="split" style="margin-top:5rem;align-items:center;">
            <div>
                <h2 class="h2">Как заказать</h2>
                <p class="muted" style="margin:1.2rem 0;">
                    Проще всего через сайт: выберите блюда в меню, положите в корзину
                    и оформите заказ с оплатой картой прямо на странице. Либо позвоните —
                    мы примем заказ по телефону.
                </p>
                <ul class="feature-list">
                    <li>
                        <span class="dot"></span>
                        <span>
                            <b>Онлайн</b>
                            <span>Оплата картой, СБП или через ЮKassa — на защищённой странице.</span>
                        </span>
                    </li>
                    <li>
                        <span class="dot"></span>
                        <span>
                            <b>В кафе</b>
                            <span>Самовывоз — 0 ₽, заказ готовим пока едете.</span>
                        </span>
                    </li>
                </ul>
                <div style="display:flex;gap:1rem;margin-top:2rem;flex-wrap:wrap;">
                    <a class="btn btn-gold" href="/Home/Menu">Открыть меню</a>
                    <a class="btn" href="tel:@menu.Phone">Позвонить</a>
                </div>
            </div>
            <img src="/img/logo.svg" alt="Lumière" style="background:var(--cream-2);padding:3rem;" />
        </div>
    </div>
</section>