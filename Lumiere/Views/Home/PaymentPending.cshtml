@{
    var orderId = ViewBag.OrderId as string;
    var paymentId = ViewBag.PaymentId as string;
    var total = ViewBag.Total is double t ? t : (double?)null;
    ViewData["Title"] = "Платёж в обработке";
}

<section>
    <div class="wrap" style="max-width:640px;text-align:center;">
        <div class="section-head">
            <span class="eyebrow">Платёж в обработке</span>
            <h1 class="h2">Почти готово</h1>
            <div class="rule"></div>
        </div>

        <p class="muted" style="margin-bottom:2rem;">
            Средства заморожены на вашей карте, но банк ещё не подтвердил списание.
            Обычно это занимает до нескольких минут. Как только платёж пройдёт,
            мы позвоним по телефону, указанному при оформлении, и начнём готовить заказ.
        </p>

        <div class="summary" style="position:static;text-align:left;">
            @if (!string.IsNullOrEmpty(orderId))
            {
                <div class="sum-row">
                    <span>Номер заказа</span>
                    <span>@orderId</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(paymentId))
            {
                <div class="sum-row">
                    <span>Идентификатор платежа</span>
                    <span>@paymentId</span>
                </div>
            }
            @if (total.HasValue)
            {
                <div class="sum-row">
                    <span>Сумма</span>
                    <span>@total.Value.ToString("0") ₽</span>
                </div>
            }
        </div>

        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;">
            <a class="btn btn-gold" href="/Home/Menu">Вернуться в меню</a>
            <a class="btn" href="/Home/Contacts">Связаться с нами</a>
        </div>
    </div>
</section>