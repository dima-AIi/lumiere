@{
    ViewData["Title"] = "Вход в панель управления";
}

<div class="admin-login-wrap">
    <form asp-controller="Admin" asp-action="Login" method="post" class="admin-login">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <img class="logo-mark" src="/img/logo.svg" alt="Lumière" />
        <span class="eyebrow">Служебный доступ</span>
        <h1 class="h2">Панель управления</h1>
        <div class="rule"></div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="field">
            <label for="password">Пароль</label>
            <input type="password" id="password" name="password" autocomplete="current-password" autofocus required />
        </div>

        <button class="btn btn-solid btn-block" type="submit">Войти</button>

        <p class="muted admin-hint">
            Служебный доступ для администратора Lumière.
        </p>
    </form>
</div>
