@model Lumiere.Models.AdminOrdersViewModel
@{
    ViewData["Title"] = "Обзор";

    string Pay(string s) => Lumiere.Models.AdminLabels.Payment(s);
    string Kitchen(string s) => Lumiere.Models.AdminLabels.Kitchen(s);
}

<div class="admin-page">
    <div class="section-head">
        <span class="eyebrow">@DateTime.Now.ToString("dddd, d MMMM")</span>
        <h1 class="h2">Обзор</h1>
        <div class="rule"></div>
    </div>

    @* --- Статистика --- *@
    <div class="admin-stats">
        <div class="admin-stat@(Model.NeedsDecisionCount > 0 ? " gold" : "")">
            <b>@Model.NeedsDecisionCount</b><span>ждут решения</span>
        </div>
        <div class="admin-stat">
            <b>@Model.CountToday</b><span>за сегодня</span>
        </div>
        <div class="admin-stat">
            <b>@Model.TotalCount</b><span>всего заказов</span>
        </div>
        <div class="admin-stat">
            <b>@Model.PaidCount</b><span>оплачено</span>
        </div>
        <div class="admin-stat gold">
            <b>@Model.RevenueToday.ToString("0") ₽</b><span>выручка сегодня</span>
        </div>
    </div>

    @* --- Заказы, ждущие решения: принять / отклонить --- *@
    @if (Model.NeedsDecisionCount > 0)
    {
        <h2 class="h3 admin-block-title">Требуют решения</h2>
        <div class="admin-cards">
            @foreach (var o in Model.Pending)
            {
                <article class="admin-card">
                    <div class="admin-card-top">
                        <span class="mono">@o.Id</span>
                        <span class="pill pay-@o.PaymentStatus">@Pay(o.PaymentStatus)</span>
                    </div>
                    <div class="admin-card-body">
                        <b>@o.Form.Name</b>
                        <a class="mono" href="tel:@o.Form.Phone">@o.Form.Phone</a>
                        <span class="muted">
                            @(o.Form.DeliveryType == "delivery" ? "Доставка" : "Самовывоз") ·
                            @((o.Total / 100).ToString("0")) ₽
                        </span>
                        <span class="muted small">@o.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                    </div>
                    <div class="admin-card-actions">
                        <form asp-controller="Admin" asp-action="Decide" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="hidden" name="accept" value="true" />
                            <button class="btn btn-gold btn-sm" type="submit">Принять</button>
                        </form>
                        <form asp-controller="Admin" asp-action="Decide" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="hidden" name="accept" value="false" />
                            <button class="btn btn-danger btn-sm" type="submit">Отклонить</button>
                        </form>
                    </div>
                    <a class="admin-card-open" href="@Context.Request.PathBase/Admin/OrderDetails/@o.Id">Подробнее →</a>
                </article>
            }
        </div>
    }

    @* --- Последние заказы --- *@
    <h2 class="h3 admin-block-title">Последние заказы</h2>
    @if (Model.Recent.Count == 0)
    {
        <div class="empty">
            <p>Заказов пока нет. Оформите тестовый заказ на сайте — он появится здесь.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Номер</th>
                        <th>Время</th>
                        <th>Клиент</th>
                        <th>Сумма</th>
                        <th>Оплата</th>
                        <th>Кухня</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Recent)
                    {
                        <tr class="@(o.IsDemo ? "is-demo" : "")">
                            <td class="mono">@o.Id</td>
                            <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                            <td>
                                <b>@o.Form.Name</b><br />
                                <a class="mono" href="tel:@o.Form.Phone">@o.Form.Phone</a>
                            </td>
                            <td class="num">@((o.Total / 100).ToString("0")) ₽</td>
                            <td><span class="pill pay-@o.PaymentStatus">@Pay(o.PaymentStatus)</span></td>
                            <td><span class="pill kitchen-@o.OrderStatus">@Kitchen(o.OrderStatus)</span></td>
                            <td class="num"><a class="link-open" href="@Context.Request.PathBase/Admin/OrderDetails/@o.Id">Открыть →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
