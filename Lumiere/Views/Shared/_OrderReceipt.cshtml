@model Lumiere.Services.Order
@inject Lumiere.Services.MenuRepository MenuRepo
@{
    // Кассовый чек заказа. Один и тот же вид используют покупатель (после оплаты)
    // и администратор (в карточке заказа, с кнопкой «Печатать»).
    var cafe = MenuRepo.Get();
    var created = Model.CreatedAt.ToLocalTime();
    var subtotal = Model.Lines.Sum(l => l.Sum);
    var delivery = Model.Form.DeliveryType == "delivery" ? (Model.Total - subtotal) : 0;
    string Rub(double kop) => (kop / 100).ToString("0");
}

<div class="receipt" id="orderReceipt">
    <div class="receipt-brand">Lumière</div>
    <div class="receipt-sub">DESSERTS &amp; COFFEE</div>
    <div class="receipt-line">@cafe.Address, @cafe.City</div>
    <div class="receipt-line">@cafe.Phone</div>

    <div class="receipt-sep"></div>
    <div class="receipt-title">КАССОВЫЙ ЧЕК</div>

    <div class="receipt-row"><span>Заказ</span><span>@Model.Id</span></div>
    <div class="receipt-row"><span>Дата</span><span>@created.ToString("dd.MM.yyyy")</span></div>
    <div class="receipt-row"><span>Время</span><span>@created.ToString("HH:mm")</span></div>
    <div class="receipt-row"><span>Клиент</span><span>@Model.Form.Name</span></div>
    @if (Model.Form.DeliveryType == "delivery")
    {
        <div class="receipt-row"><span>Способ</span><span>Доставка</span></div>
    }
    else
    {
        <div class="receipt-row"><span>Способ</span><span>Самовывоз</span></div>
    }

    <div class="receipt-sep"></div>
    @foreach (var line in Model.Lines)
    {
        <div class="receipt-item">@line.Name</div>
        <div class="receipt-row receipt-row-calc">
            <span>@line.Qty × @Rub(line.Price) ₽</span>
            <span>@Rub(line.Sum) ₽</span>
        </div>
    }

    <div class="receipt-sep"></div>
    <div class="receipt-row"><span>Товары</span><span>@Rub(subtotal) ₽</span></div>
    @if (delivery > 0)
    {
        <div class="receipt-row"><span>Доставка</span><span>@Rub(delivery) ₽</span></div>
    }
    <div class="receipt-row receipt-total"><span>ИТОГО</span><span>@Rub(Model.Total) ₽</span></div>

    <div class="receipt-sep"></div>
    <div class="receipt-foot">
        Спасибо за покупку!<br />Ждём вас снова в Lumière
    </div>
    @if (Model.IsDemo)
    {
        <div class="receipt-demo">ДЕМО-ЧЕК · оплата не подключена</div>
    }
</div>
