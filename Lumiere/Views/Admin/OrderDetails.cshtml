@model Lumiere.Services.Order
@{
    ViewData["Title"] = $"Заказ {Model.Id}";

    string PayLabel(string s) => Lumiere.Models.AdminLabels.Payment(s);
    string KitchenLabel(string s) => Lumiere.Models.AdminLabels.Kitchen(s);
}

<div class="admin-page">
    <a class="link-back" href="@Context.Request.PathBase/Admin/Orders">← Ко всем заказам</a>

    <div class="section-head">
        <span class="eyebrow">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
        <h1 class="h2">Заказ <span class="mono">@Model.Id</span></h1>
        <div class="rule"></div>
        <div class="admin-decision">
            @if (Model.IsDemo)
            {
                <span class="pill pay-demo">Демо-заказ</span>
            }
            <span class="pill kitchen-@Model.OrderStatus">@KitchenLabel(Model.OrderStatus)</span>
        </div>
    </div>

    <div class="admin-detail">
        @* --- Клиент и доставка --- *@
        <section class="admin-panel">
            <h3>Клиент</h3>
            <div class="kv"><span>Имя</span><b>@Model.Form.Name</b></div>
            <div class="kv"><span>Телефон</span><b><a class="mono" href="tel:@Model.Form.Phone">@Model.Form.Phone</a></b></div>
            <div class="kv"><span>Получение</span><b>@(Model.Form.DeliveryType == "delivery" ? "Доставка" : "Самовывоз")</b></div>
            @if (Model.Form.DeliveryType == "delivery")
            {
                <div class="kv"><span>Адрес</span><b>@Model.Form.Address</b></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Form.Comment))
            {
                <div class="kv"><span>Комментарий</span><b>@Model.Form.Comment</b></div>
            }
        </section>

        @* --- Состав заказа --- *@
        <section class="admin-panel">
            <h3>Состав</h3>
            <div class="admin-lines">
                @foreach (var line in Model.Lines)
                {
                    <div class="admin-line">
                        <img src="@line.ImgUrl" alt="@line.Name" />
                        <div class="admin-line-in">
                            <b>@line.Name</b>
                            <span class="muted">@((line.Price / 100).ToString("0")) ₽ × @line.Qty</span>
                        </div>
                        <span class="price">@((line.Sum / 100).ToString("0")) ₽</span>
                    </div>
                }
            </div>
            <div class="sum-row total">
                <span>К оплате</span>
                <span>@((Model.Total / 100).ToString("0")) ₽</span>
            </div>
        </section>

        @* --- Оплата --- *@
        <section class="admin-panel">
            <h3>Оплата</h3>
            <div class="kv"><span>Статус</span><b><span class="pill pay-@Model.PaymentStatus">@PayLabel(Model.PaymentStatus)</span></b></div>
            <div class="kv"><span>ID платежа</span><b class="mono small">@(Model.PaymentId ?? "—")</b></div>
            @if (Model.PaidAt.HasValue)
            {
                <div class="kv"><span>Оплачено</span><b>@Model.PaidAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</b></div>
            }
        </section>

        @* --- Управление --- *@
        <section class="admin-panel">
            @* Решение по заказу: принять / отклонить. *@
            <h3>Решение по заказу</h3>
            @if (Model.NeedsDecision)
            {
                <p class="muted" style="font-size:.84rem;margin-bottom:1rem;">
                    Заказ ждёт вашего решения. Нажмите «Принять», чтобы взять в работу, или «Отклонить», чтобы отменить.
                </p>
                <div class="admin-actions">
                    <form asp-controller="Admin" asp-action="Decide" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="accept" value="true" />
                        <button class="btn btn-gold" type="submit">Принять заказ</button>
                    </form>
                    <form asp-controller="Admin" asp-action="Decide" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="accept" value="false" />
                        <button class="btn btn-danger" type="submit">Отклонить заказ</button>
                    </form>
                </div>
            }
            else
            {
                <div class="admin-note">
                    <span class="pill kitchen-@Model.OrderStatus">@KitchenLabel(Model.OrderStatus)</span>
                    @if (Model.DecidedAt.HasValue)
                    {
                        <span>решение принято @Model.DecidedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    }
                </div>
            }

            @* Дальнейший статус на кухне — только для принятых (не для новых и не для отклонённых). *@
            @if (Model.OrderStatus != "declined")
            {
                <hr />
                <h3>Статус на кухне</h3>
                <form asp-controller="Admin" asp-action="SetOrderStatus" method="post" class="admin-status-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="kitchen-tabs">
                        @foreach (var s in new[] { "new", "accepted", "cooking", "ready", "done" })
                        {
                            <label class="@(Model.OrderStatus == s ? "checked" : "")">
                                <input type="radio" name="status" value="@s" @(Model.OrderStatus == s ? "checked" : "") />
                                <span>@KitchenLabel(s)</span>
                            </label>
                        }
                    </div>
                    <p class="status-hint muted small" style="margin-top:.8rem;">Статус меняется сразу при выборе — просто нажми на нужный.</p>
                </form>
            }

            @if (Model.PaymentStatus != "succeeded" && !Model.IsDemo)
            {
                <hr />
                <h3>Платёж</h3>
                <form asp-controller="Admin" asp-action="SetPaymentStatus" method="post" class="admin-status-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="kitchen-tabs">
                        @foreach (var s in new[] { "succeeded", "pending", "canceled" })
                        {
                            <label class="@(Model.PaymentStatus == s ? "checked" : "")">
                                <input type="radio" name="status" value="@s" @(Model.PaymentStatus == s ? "checked" : "") />
                                <span>@PayLabel(s)</span>
                            </label>
                        }
                    </div>
                    <button class="btn btn-sm" type="submit">Обновить статус оплаты</button>
                </form>
            }
        </section>
    </div>

    @* --- Чек заказа + печать (только для админа) --- *@
    <section class="admin-panel receipt-panel" style="margin-top:1.4rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.1rem;">
            <h3 style="margin:0;">Чек заказа</h3>
            <button type="button" class="btn btn-gold btn-sm" id="printReceiptBtn">Печатать чек</button>
        </div>
        <div class="receipt-holder">
            <partial name="_OrderReceipt" model="Model" />
        </div>
        <p class="muted small" style="margin-top:1rem;">
            Кнопка «Печатать чек» отправит этот чек на принтер (в диалоге печати выберите нужный принтер).
        </p>
    </section>
</div>

@section Scripts {
    <script>
        // Печать только чека: прячем всё, кроме него, затем печатаем и возвращаем вид.
        (function () {
            var btn = document.getElementById('printReceiptBtn');
            if (!btn) return;
            btn.addEventListener('click', function () {
                document.body.classList.add('printing-receipt');
                window.print();
            });
            // Safari вызывает beforeprint/afterprint ненадёжно — возвращаем класс по таймеру тоже.
            window.addEventListener('afterprint', function () {
                document.body.classList.remove('printing-receipt');
            });
        })();

        // Статус (кухня и оплата): клик по пилюле сразу подсвечивает её и сохраняет форму.
        // Форма перезагружает страницу, сервер перерисовывает уже с новым статусом.
        document.querySelectorAll('.kitchen-tabs').forEach(function (tabs) {
            var form = tabs.closest('form');
            if (!form) return;

            // Запоминаем статус, который стоит сейчас, чтобы не сохранять тот же самый повторно.
            tabs.querySelectorAll('input[type=radio]').forEach(function (radio) {
                if (radio.checked) radio.dataset.current = '1';
            });

            tabs.addEventListener('change', function (e) {
                var radio = e.target;
                if (!radio || radio.type !== 'radio') return;

                // Выбрали тот же статус, что уже активен — сохранять нечего.
                // (подсветка и сохранение выполняются при любом клике — кнопка не «молчит»)

                // Сразу переносим золотую подсветку на выбранную пилюлю.
                tabs.querySelectorAll('label').forEach(function (l) { l.classList.remove('checked'); });
                var lbl = radio.closest('label');
                if (lbl) lbl.classList.add('checked');

                // Защита от двойной отправки, пока идёт сохранение.
                // Страница сразу перезагрузится с новым статусом — защита от двойной отправки не нужна.

                // Небольшая задержка, чтобы подсветка успела отрисоваться до перезагрузки.
                if (typeof form.requestSubmit === 'function') { form.requestSubmit(); } else { form.submit(); }
            });
        });
    </script>
}
