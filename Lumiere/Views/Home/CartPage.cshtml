@model Lumiere.Models.Cart
@{
    ViewData["Title"] = "Корзина";
    var menu = (Lumiere.Models.MenuData)ViewBag.Menu!;
}

<section>
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">Ваш заказ</span>
            <h1 class="h2">Корзина</h1>
            <div class="rule"></div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty">
                <h3 class="h3">В корзине пока пусто</h3>
                <p>Загляните в меню — там есть что попробовать.</p>
                <a class="btn btn-gold" href="/Home/Menu">Открыть меню</a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <div>
                    @foreach (var line in Model.Lines)
                    {
                        <div class="cart-line">
                            <img src="@line.ImgUrl" alt="@line.Name" />

                            <div>
                                <h4>@line.Name</h4>
                                <p class="meta">@((line.Price / 100).ToString("0")) ₽ за штуку</p>

                                <form asp-controller="Home" asp-action="CartSetQty" method="post" style="margin-top:.7rem;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@line.Id" />
                                    <div class="qty">
                                        <button type="submit" name="qty" value="@(line.Qty - 1)" aria-label="Меньше">−</button>
                                        <span>@line.Qty</span>
                                        <button type="submit" name="qty" value="@(line.Qty + 1)" aria-label="Больше">+</button>
                                    </div>
                                </form>
                            </div>

                            <div class="right">
                                <span class="price">@((line.Sum / 100).ToString("0")) ₽</span>
                                <form asp-controller="Home" asp-action="CartRemove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@line.Id" />
                                    <button class="link-remove" type="submit">Убрать</button>
                                </form>
                            </div>
                        </div>
                    }

                    <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
                        <a class="btn" href="/Home/Menu">Продолжить выбирать</a>
                        <form asp-controller="Home" asp-action="ClearCart" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-gold" type="submit">Очистить корзину</button>
                        </form>
                    </div>
                </div>

                <aside class="summary">
                    <h3>Итого</h3>

                    <form asp-controller="Home" asp-action="SetDelivery" method="post" style="margin-bottom:1.2rem;">
                        @Html.AntiForgeryToken()
                        <div class="delivery-tabs">
                            <button type="submit" name="type" value="pickup"
                                    class="@(Model.IsDelivery ? "" : "active")">
                                Самовывоз · 0 ₽
                            </button>
                            <button type="submit" name="type" value="delivery"
                                    class="@(Model.IsDelivery ? "active" : "")">
                                Доставка · @((menu.DeliveryPrice / 100).ToString("0")) ₽
                            </button>
                        </div>
                    </form>

                    <div class="sum-row">
                        <span>Позиций: @Model.Count</span>
                        <span>@((Model.Subtotal / 100).ToString("0")) ₽</span>
                    </div>
                    <div class="sum-row">
                        <span>@(Model.IsDelivery ? "Доставка" : "Самовывоз")</span>
                        <span>@((Model.Delivery / 100).ToString("0")) ₽</span>
                    </div>
                    <div class="sum-row total">
                        <span>К оплате</span>
                        <span>@((Model.Total / 100).ToString("0")) ₽</span>
                    </div>

                    <a class="btn btn-solid btn-block" style="margin-top:1.5rem;" href="/Home/Checkout">
                        Оформить заказ
                    </a>

                    <div class="pay-logos" style="justify-content:center;">
                        <span class="pay-logo">МИР</span>
                        <span class="pay-logo">Visa</span>
                        <span class="pay-logo">СБП</span>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>