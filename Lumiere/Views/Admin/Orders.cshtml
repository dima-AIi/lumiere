@model Lumiere.Models.AdminOrdersViewModel
@{
    ViewData["Title"] = "Заказы";

    // Человекочитаемые подписи статусов (единый источник — AdminLabels).
    string PayLabel(string s) => Lumiere.Models.AdminLabels.Payment(s);
    string KitchenLabel(string s) => Lumiere.Models.AdminLabels.Kitchen(s);
}

<div class="admin-page">
    <div class="section-head">
        <span class="eyebrow">Служебный раздел</span>
        <h1 class="h2">Заказы</h1>
        <div class="rule"></div>
    </div>

    @* --- Плашка статистики --- *@
    <div class="admin-stats">
        <div class="admin-stat">
            <b>@Model.TotalCount</b><span>всего заказов</span>
        </div>
        <div class="admin-stat">
            <b>@Model.PaidCount</b><span>оплачено</span>
        </div>
        <div class="admin-stat gold">
            <b>@Model.Revenue.ToString("0") ₽</b><span>выручка (оплачено)</span>
        </div>
        <div class="admin-stat">
            <b>@Model.CountToday</b><span>за сегодня</span>
        </div>
        <div class="admin-stat">
            <b>@Model.RevenueToday.ToString("0") ₽</b><span>выручка сегодня</span>
        </div>
    </div>

    @* --- Фильтры --- *@
    <form method="get" class="admin-filters">
        <input type="text" name="q" value="@Model.Q" placeholder="Номер, имя или телефон…" />

        <select name="status" onchange="this.form.submit()">
            <option value="all" selected="@(Model.Status == "all")">Все статусы оплаты</option>
            <option value="succeeded" selected="@(Model.Status == "succeeded")">Оплачено</option>
            <option value="pending" selected="@(Model.Status == "pending")">В обработке</option>
            <option value="created" selected="@(Model.Status == "created")">Создан</option>
            <option value="canceled" selected="@(Model.Status == "canceled")">Отменён</option>
            <option value="demo" selected="@(Model.Status == "demo")">Демо</option>
        </select>

        <select name="period" onchange="this.form.submit()">
            <option value="all" selected="@(Model.Period == "all")">Всё время</option>
            <option value="today" selected="@(Model.Period == "today")">Сегодня</option>
            <option value="week" selected="@(Model.Period == "week")">7 дней</option>
        </select>

        <button class="btn btn-gold btn-sm" type="submit">Найти</button>
        <a class="btn btn-sm" href="@Context.Request.PathBase/Admin/Orders">Сбросить</a>
    </form>

    @if (Model.Orders.Count == 0)
    {
        <div class="empty">
            <h3 class="h3">Заказов нет</h3>
            <p>Пока никто ничего не заказал. Попробуйте сбросить фильтры или оформить тестовый заказ на сайте.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Номер</th>
                        <th>Дата</th>
                        <th>Клиент</th>
                        <th>Получение</th>
                        <th class="num">Сумма</th>
                        <th>Оплата</th>
                        <th>Кухня</th>
                        <th>Действие</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr class="@(o.IsDemo ? "is-demo" : "")">
                            <td class="mono">@o.Id</td>
                            <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <b>@o.Form.Name</b><br />
                                <a class="mono" href="tel:@o.Form.Phone">@o.Form.Phone</a>
                            </td>
                            <td>@(o.Form.DeliveryType == "delivery" ? "Доставка" : "Самовывоз")</td>
                            <td class="num">@((o.Total / 100).ToString("0")) ₽</td>
                            <td><span class="pill pay-@o.PaymentStatus">@PayLabel(o.PaymentStatus)</span></td>
                            <td><span class="pill kitchen-@o.OrderStatus">@KitchenLabel(o.OrderStatus)</span></td>
                            <td>
                                @if (o.NeedsDecision)
                                {
                                    <div class="admin-card-actions" style="margin:0;">
                                        <form asp-controller="Admin" asp-action="Decide" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@o.Id" />
                                            <input type="hidden" name="accept" value="true" />
                                            <button class="btn btn-gold btn-sm" type="submit">Принять</button>
                                        </form>
                                        <form asp-controller="Admin" asp-action="Decide" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@o.Id" />
                                            <input type="hidden" name="accept" value="false" />
                                            <button class="btn btn-danger btn-sm" type="submit">Отклонить</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <a class="link-open" href="@Context.Request.PathBase/Admin/OrderDetails/@o.Id">Открыть →</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
