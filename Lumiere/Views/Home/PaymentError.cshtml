@{
    var paymentId = ViewBag.PaymentId as string;
    var status = ViewBag.Status as string;
    var reason = ViewBag.Reason as string;
    ViewData["Title"] = "Ошибка оплаты";
}

<section>
    <div class="wrap" style="max-width:660px;text-align:center;">
        <div class="section-head">
            <span class="eyebrow">Ошибка оплаты</span>
            <h1 class="h2">Не получилось провести оплату</h1>
            <div class="rule"></div>
        </div>

        <p class="muted" style="margin-bottom:2rem;">
            @(reason ?? "Платёж не был подтверждён платёжной системой. Деньги не списаны — "
                + "корзина осталась у вас, можно попробовать снова или позвонить нам.")
        </p>

        <div class="summary" style="position:static;text-align:left;">
            @if (!string.IsNullOrEmpty(paymentId))
            {
                <div class="sum-row">
                    <span>Идентификатор платежа</span>
                    <span>@paymentId</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(status))
            {
                <div class="sum-row">
                    <span>Статус в ЮKassa</span>
                    <span>@status</span>
                </div>
            }
        </div>

        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;">
            <a class="btn btn-gold" href="/Home/CartPage">Вернуться в корзину</a>
            <a class="btn" href="/Home/Contacts">Связаться с нами</a>
        </div>
    </div>
</section>