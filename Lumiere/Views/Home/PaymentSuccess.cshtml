@{
    var orderId = ViewBag.OrderId as string;
    var paymentId = ViewBag.PaymentId as string;
    var order = ViewBag.Order as Lumiere.Services.Order;
    ViewData["Title"] = "Спасибо за заказ";
}

<section>
    <div class="wrap" style="max-width:640px;text-align:center;">
        <div class="section-head">
            <span class="eyebrow">@(order?.IsDemo == true ? "Демонстрационный заказ" : "Оплата прошла")</span>
            <h1 class="h2">Спасибо за заказ</h1>
            <div class="rule"></div>
        </div>

        <p class="muted" style="margin-bottom:2rem;">
            @if (order?.IsDemo == true)
            {
                <text>Это учебный демонстрационный заказ. Реальная оплата не проводилась, деньги не списаны.</text>
            }
            else
            {
                <text>Платёж успешно проведён. О готовности сообщим по телефону, указанному при оформлении.</text>
            }
        </p>

        @if (!string.IsNullOrEmpty(orderId))
        {
            <div class="summary" style="position:static;text-align:left;">
                <div class="sum-row">
                    <span>Номер заказа</span>
                    <span>@orderId</span>
                </div>
            </div>
        }

        @* Идентификатор платежа и кассовый чек скрыты под кнопкой,
           чтобы не перегружать экран. Номер заказа остаётся видимым как ориентир. *@
        @if (!string.IsNullOrEmpty(paymentId) || order != null)
        {
            <details class="order-details">
                <summary class="order-details-btn">Подробности о заказе</summary>
                <div class="order-details-body">
                    @if (!string.IsNullOrEmpty(paymentId))
                    {
                        <div class="sum-row">
                            <span>Идентификатор платежа</span>
                            <span>@paymentId</span>
                        </div>
                    }
                    @if (order != null)
                    {
                        <div class="receipt-holder">
                            <partial name="_OrderReceipt" model="order" />
                        </div>
                    }
                </div>
            </details>
        }

        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;">
            <a class="btn btn-gold" href="/Home/Menu">Вернуться в меню</a>
            <a class="btn" href="/">На главную</a>
        </div>
    </div>
</section>
@section Scripts {
    <script>try { localStorage.removeItem('lumiere.cart.v1'); } catch (e) { }</script>
}
